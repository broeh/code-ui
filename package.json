{
  "name": "code-ui",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:ui": "node tools/visual/release-smoke.cjs",
    "check:rust": "python3 tools/release/notices.py && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --locked --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --locked",
    "preview:desktop": "bash tools/preview.sh",
    "build:linux": "tauri build --bundles deb,appimage"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.17",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-opener": "^2",
    "@uiw/react-codemirror": "^4.25.12",
    "fzf": "^0.5.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "playwright": "1.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.4"
  },
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0"
}
